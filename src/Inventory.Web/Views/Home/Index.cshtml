@model DashboardViewModel

@*
    The board is a live region: everything below the page band is re-read from
    /live/overview whenever the Inventory hub says stock moved. The wrapper is what gets
    replaced, so the markup of the board itself lives in one partial and is used both by
    this page and by that fragment.
*@
<div class="live-region"
     data-live="page"
     data-live-source="/live/overview"
     data-live-stamp="true"
     aria-live="polite"
     aria-busy="false">
    <partial name="_Overview" model="Model" />
</div>
