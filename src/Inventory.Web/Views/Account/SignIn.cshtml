@model SignInViewModel

@{
    ViewData["Title"] = "Sign in";
    ViewData["Nav"] = string.Empty;
    ViewData["Section"] = "Console";
}

<section class="signin">
    <h2>Sign in to the inventory system</h2>

    @if (Model.Refusal is not null)
    {
        <p class="flash flash--attention" role="alert">@Model.Refusal</p>
    }

    <div class="validation-summary" asp-validation-summary="All"></div>

    <form class="form-panel" method="post" asp-controller="Account" asp-action="SignIn">
        <input type="hidden" name="ReturnUrl" value="@Model.Form.ReturnUrl" />

        <div class="form-grid">
            <div class="field">
                <label for="Username">@Html.DisplayNameFor(model => model.Form.Username)</label>
                <input id="Username" name="Username" type="text" value="@Model.Form.Username"
                       autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
                <span class="field__error">@Html.ValidationMessage("Username")</span>
            </div>

            <div class="field">
                <label for="Password">Password</label>
                <input id="Password" name="Password" type="password" autocomplete="current-password" required />
                <span class="field__error">@Html.ValidationMessage("Password")</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Sign in</button>
        </div>
    </form>

    <p class="hint-inline">
        A session lasts 24 H. Session will be saved after that you need to sign in again.
    </p>
</section>
