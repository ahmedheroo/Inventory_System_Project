@model EditProductForm

@{
    ViewData["Title"] = $"Edit {Model.Sku}";
    var categories = Pickers.Categories(Model.Categories, Model.CategoryId, "Uncategorised");
}

@section Actions {
    @if (!Model.IsActive)
    {
        <span class="state state--muted">Inactive product</span>
    }
    <a class="btn btn--quiet" href="/inventory?productId=@Model.Id">Stock for this product</a>
    @if (Model.IsActive)
    {
        <form asp-controller="Products" asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
              data-confirm="Deactivate @Model.Sku? It keeps its stock and its history, and disappears from the product list.">
            <button type="submit" class="btn btn--critical">Deactivate</button>
        </form>
    }
    else
    {
        <form asp-controller="Products" asp-action="Activate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn">Activate</button>
        </form>
    }
}

<section>
    <form class="form-panel" method="post" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id">
        <h3>@Model.Name</h3>
        <p class="meta">Product @Model.Id · sku <span class="id">@Model.Sku</span></p>

        <div class="validation-summary" asp-validation-summary="All"></div>

        <div class="form-grid">
            <div class="field">
                <label for="Name">Name</label>
                <input id="Name" name="Name" type="text" value="@Model.Name" maxlength="200" required autofocus />
                <span class="field__error">@Html.ValidationMessage("Name")</span>
            </div>

            <partial name="_Select" model="categories" />

            <div class="field">
                <label for="UnitPrice">Unit price</label>
                <input id="UnitPrice" name="UnitPrice" type="number" step="0.01" min="0" value="@Display.Amount(Model.UnitPrice)" required />
                <span class="field__hint">Changing the price revalues the stock that is already on hand.</span>
                <span class="field__error">@Html.ValidationMessage("UnitPrice")</span>
            </div>

            <div class="field">
                <label for="MinimumStockLevel">Minimum stock level</label>
                <input id="MinimumStockLevel" name="MinimumStockLevel" type="number" step="1" min="0" value="@Model.MinimumStockLevel" required />
                <span class="field__hint">The threshold the Alert service watches.</span>
                <span class="field__error">@Html.ValidationMessage("MinimumStockLevel")</span>
            </div>

            <div class="field field--wide">
                <label for="Description">Description</label>
                <textarea id="Description" name="Description" rows="3" maxlength="1000">@Model.Description</textarea>
                <span class="field__error">@Html.ValidationMessage("Description")</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Save product</button>
            <a class="btn btn--quiet" asp-controller="Products" asp-action="Index">Back to the product list</a>
        </div>
    </form>
</section>

<section>
    <form class="form-panel" method="post" asp-controller="Products" asp-action="ChangeSku" asp-route-id="@Model.Id"
          data-confirm="Change the sku from @Model.Sku? Ledger entries already written keep the old sku in their audit trail.">
        <h3>Change the sku</h3>
        <p class="meta">
            A correction, not a routine edit: the sku is written on labels and quoted in movement records.
            It has to stay unique across the catalogue.
        </p>

        <div class="form-grid">
            <div class="field">
                <label for="sku">New sku</label>
                <input id="sku" name="sku" type="text" value="@Model.Sku" maxlength="50" required />
                <span class="field__hint">Up to 50 characters.</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--quiet">Change the sku</button>
        </div>
    </form>
</section>
