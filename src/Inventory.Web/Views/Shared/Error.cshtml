@model ErrorViewModel

<section class="fault">
    <h2>Something went wrong in the console</h2>
    <p class="lede">
        The page could not be produced. Nothing was written: this console only reads from the
        services and sends their operations, so no record is left half-changed by this screen.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="fault__status">Request @Model.RequestId</p>
    }

    <p>
        <a class="btn" href="/">Go to the overview</a>
        <a class="btn btn--quiet" href="@Context.Request.Path">Try this page again</a>
    </p>
</section>
