{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "AlertDb": "Server=localhost,1433;Database=AlertDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "RabbitMq": {
    "//": "Matches docker-compose.yml. Override with RabbitMq__HostName etc., or set Enabled=false to run the API without a broker.",
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "inventory",
    "Password": "inventory",
    "VirtualHost": "/",
    "ClientName": "alert-service"
  }
}
