    "Port": 5672,
    "UserName": "inventory",
    "Password": "inventory",
    "VirtualHost": "/",
    "ClientName": "reporting-service"
  },
  "Services": {
    "ProductApi": {
      "BaseUrl": "http://localhost:5251"
    }
  }
}
