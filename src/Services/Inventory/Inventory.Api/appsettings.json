{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "//": "Matches docker-compose.yml. Override with RabbitMq__HostName etc., or set Enabled=false to keep events in the outbox without a broker.",
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "inventory",
    "Password": "inventory",
    "VirtualHost": "/",
    "ClientName": "inventory-service"
  },
  "Outbox": {
    "//": "The dispatcher drains OutboxMessages to RabbitMQ. Backoff is exponential and capped; there is no attempt limit, so an event leaves the outbox only once the broker has confirmed it.",
    "PollSeconds": 5,
    "BatchSize": 50,
    "InitialRetrySeconds": 2,
    "MaxRetrySeconds": 60
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "InventoryDb": "Server=.;Database=InventoryDb;User Id=sa;Password=InventoryDB@123;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Services": {
    "ProductApi": {
      "BaseUrl": "http://localhost:5251"
    }
  }
}
