# Generated by Ansible (roles/deploy) - do not edit on the server.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../k8s/overlays/{{ env_name }}
images:
{% for image in inventory_images %}
  - name: {{ image }}
    newName: docker.io/{{ dockerhub_username }}/{{ image }}
    newTag: "{{ image_tag }}"
{% endfor %}
# Changes only when a secret value changes, so the pods (SQL Server and RabbitMQ included) restart to
# pick the new value up, and are otherwise left alone between releases.
commonAnnotations:
  inventory-system/secrets-checksum: "{{ inventory_secrets | to_json | hash('sha256') }}"
