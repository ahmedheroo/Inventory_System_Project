# Docker Hub Configuration
DOCKERHUB_USERNAME=yourdockerhubusername
IMAGE_TAG=latest

# Database Credentials
MSSQL_SA_PASSWORD=YourStrong@Password_Prod2026!
SQL_PORT=1433

# RabbitMQ Credentials
RABBITMQ_USER=inventory_admin
RABBITMQ_PASSWORD=YourRabbitPasswordProd_2026!
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Security & JWT (Must be at least 32 characters / 256 bits)
JWT_SIGNING_KEY=a-very-long-secret-key-with-at-least-32-chars-for-prod

# Service Ports
PRODUCT_API_PORT=5251
IDENTITY_API_PORT=5402
INVENTORY_API_PORT=5102
ALERT_API_PORT=5212
REPORTING_API_PORT=5312
CONSOLE_PORT=5159
